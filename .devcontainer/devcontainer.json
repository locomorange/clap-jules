{
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    }
  },
  "postCreateCommand": [
    "bash", "-c", 
    "git submodule update --init --recursive && ./scripts/verify-environment.sh && ./scripts/environment-summary.sh"
  ],
  "remoteUser": "ubuntu",
  "workspaceFolder": "/workspaces/clap-jules",
  "mounts": [
    "source=devcontainer-clap-cache,target=/opt/vcpkg/buildtrees,type=volume",
    "source=devcontainer-clap-host-cache,target=/workspaces/clap-jules/clap-host-repo,type=volume"
  ]
  ,
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.vscode-github-actions",
        "ms-vscode.cpptools"
      ]
    }
  }
}
