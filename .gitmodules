	path = libs/clap-helpers
	url = https://github.com/free-audio/clap-helpers.git
[submodule "libs/skia"]
	path = libs/skia
	url = https://github.com/google/skia.git
[submodule "libs/glfw"]
	path = libs/glfw
	url = https://github.com/glfw/glfw.git
